---
import { FileText, Github, Play, Globe } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import ExternalLink from './ExternalLink.astro';

interface Props {
  links: CollectionEntry<'publications' | 'projects'>['data']['links'];
}

const { links } = Astro.props;
const icons = { paper: FileText, code: Github, demo: Play, website: Globe };
---

{links.length > 0 && (
  <div class="flex flex-wrap items-center gap-3">
    {links.map((link) => {
      const Icon = icons[link.kind];
      return (
        <ExternalLink
          href={link.url}
          iconClass="text-gray-400"
          class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:border-blue-300 hover:text-blue-700 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-600 dark:hover:text-blue-300"
        >
          <Icon size={16} aria-hidden="true" />
          {link.label}
        </ExternalLink>
      );
    })}
  </div>
)}
