---
import type { CollectionEntry } from 'astro:content';
interface Props { status: CollectionEntry<'projects'>['data']['status']; }
const { status } = Astro.props;
const colors = {
  Active: 'border-green-200 bg-green-100 text-green-700 dark:border-green-900 dark:bg-green-950/40 dark:text-green-300',
  Completed: 'border-blue-200 bg-blue-100 text-blue-700 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-300',
  Archived: 'border-gray-200 bg-gray-100 text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300',
};
---
<span class:list={['rounded-full border px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide', colors[status]]}>{status}</span>
