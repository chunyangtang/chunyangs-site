---
import { ArrowLeft } from 'lucide-react';
import Layout from './Layout.astro';
import MathStyles from '../components/MathStyles.astro';

interface Props {
  title: string;
  description: string;
  backHref: string;
  backLabel: string;
}

const { title, description, backHref, backLabel } = Astro.props;
---

<Layout title={`${title} | Chunyang Tang`} description={description}>
  <Fragment slot="head">
    <MathStyles />
    <slot name="head" />
  </Fragment>
  <article class="mx-auto max-w-5xl px-4 py-8 pb-20 sm:px-6 sm:py-12 sm:pb-24">
    <a href={backHref} class="mb-9 inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition-colors hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
      <ArrowLeft size={16} aria-hidden="true" /> {backLabel}
    </a>
    <header class="mx-auto mb-8 max-w-4xl sm:mb-10">
      <slot name="eyebrow" />
      <h1 class="mt-4 text-3xl font-bold leading-[1.15] tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-gray-100">{title}</h1>
      <slot name="metadata" />
      <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-300">{description}</p>
      <div class="mt-6"><slot name="actions" /></div>
      <slot name="context" />
    </header>
    <slot name="figure" />
    <div class="mx-auto max-w-3xl">
      <div class="markdown-content prose prose-lg max-w-none prose-headings:font-bold dark:prose-invert">
        <slot />
      </div>
      <slot name="after-content" />
    </div>
  </article>
</Layout>
