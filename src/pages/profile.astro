---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Download, Mail, Github, Linkedin, ExternalLink, GraduationCap } from 'lucide-react';
import profileImage from '../assets/profile.jpg';

import { education } from '../../data/cv';
import PublicationItem from '../components/PublicationItem.astro';
import { getPublications } from '../lib/content';
import { siteProfile } from '../../data/site';

const publications = await getPublications();

const aboutLinkClass =
  'text-blue-600 dark:text-blue-400 font-medium decoration-2 underline-offset-3 decoration-blue-400/50 dark:decoration-blue-700/70 hover:text-blue-700 dark:hover:text-blue-300 hover:decoration-blue-500 dark:hover:decoration-blue-500 transition-colors';
---

<Layout title="Profile | Chunyang">
  <div class="page-container py-12">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      
      <aside class="md:col-span-4 lg:col-span-3">
        <div class="sticky top-24 space-y-8">
          
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <div class="relative aspect-square overflow-hidden rounded-2xl bg-gray-100 ring-1 ring-gray-900/5">
                <Image 
                    src={profileImage} 
                    alt="Chunyang Profile" 
                    width={400} 
                    height={400} 
                    class="object-cover w-full h-full"
                />
            </div>
          </div>

          <div>
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">{siteProfile.name}</h1>
            <p class="text-lg text-gray-600 dark:text-gray-400 mt-1">{siteProfile.role}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{siteProfile.affiliation}</p>
            
            <div class="flex gap-4 mt-6">
                <a href={`mailto:${siteProfile.email}`} aria-label="Send email" class="text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">
                    <Mail size={22} />
                </a>
                <a href={siteProfile.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" class="text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">
                    <Github size={22} />
                </a>
                <a href={siteProfile.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" class="text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                    <Linkedin size={22} />
                </a>
                <a href={siteProfile.googleScholarUrl} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar profile" class="text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                    <GraduationCap size={22} />
                </a>
            </div>
          </div>

          <!-- <button
            type="button"
            disabled
            title="CV download will be available soon."
            class="flex items-center justify-center w-full gap-2 px-4 py-3 bg-gray-900/80 dark:bg-gray-100/90 text-gray-100 dark:text-black rounded-xl opacity-75 cursor-not-allowed"
          >
            <Download size={18} />
            <span class="font-medium">Download CV (Soon)</span>
          </button> -->

        </div>
      </aside>


<div class="md:col-span-8 lg:col-span-8 space-y-12">
        
        <section class="max-w-none prose prose-slate prose-lg">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-3">
             About Me
          </h2>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            My name is Chunyang Tang (唐春洋).
            I am a PhD student at <a href="https://collegeai.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer" class={aboutLinkClass}>College of AI</a>, 
            <a href="https://www.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer" class={aboutLinkClass}>Tsinghua University</a>  
            advised by <a href="https://media.au.tsinghua.edu.cn/info/1009/1112.htm" target="_blank" rel="noopener noreferrer" class={aboutLinkClass}>Prof. Qionghai Dai (戴琼海)</a>.
            My current research focuses on <strong class="text-gray-900 dark:text-gray-100 font-semibold">AI for ophthalmology</strong>, particularly developing algorithms for detecting subtle lesions in fundus images. I also work on translating advanced machine learning methods into clinically meaningful systems that can operate reliably in real-world environments.
          </p>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-4">
            I am broadly interested in the evolving landscape of large-scale AI, including foundation models, LLMs, diffusion models, and multimodal vision–language architectures. I am particularly curious about their adaptation, alignment, and robustness in real-world domains.
          </p>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-4">
            Previously, I worked on photoelectronic computing and diffractive neural networks (D²NN), investigating optical approaches to computation. These experiences shaped my long-term interest in the relationship between computational architecture and intelligent behavior.
          </p>
        </section>

        <hr class="border-gray-100 dark:border-gray-800" />

<section>
             <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8 flex items-center gap-3">
                Education
            </h2>
            <div class="space-y-8">
                {education.map((edu) => (
                    <div class="flex flex-col sm:flex-row gap-2 sm:gap-6 group">
                        <div class="min-w-[120px] text-gray-400 font-mono text-sm pt-1 shrink-0 group-hover:text-blue-500 transition-colors">
                            {edu.year}
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{edu.school}</h3>
                            <div class="text-gray-700 dark:text-gray-300 font-medium mt-1">{edu.degree}</div>
                            
                            <div class="text-sm mt-0.5">
                                {edu.departmentUrl ? (
                                    <a 
                                        href={edu.departmentUrl} 
                                        target="_blank" 
                                        rel="noopener noreferrer"
                                        class="text-gray-500 hover:text-blue-600 transition-colors flex items-center gap-1 w-fit"
                                    >
                                        {edu.department}
                                        <ExternalLink size={12} className="inline-block opacity-50" />
                                    </a>
                                ) : (
                                    <span class="text-gray-500">{edu.department}</span>
                                )}
                            </div>
                            
                            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mt-2 text-justify">
                                {edu.details}
                            </p>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <hr class="border-gray-100 dark:border-gray-800" />

        <section id="publications" class="scroll-mt-24">
          <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-gray-100">Publications</h2>
          <div class="space-y-8">
            {publications.map((entry) => <PublicationItem entry={entry} />)}
          </div>
        </section>

      </div>
    </div>
  </div>
</Layout>
