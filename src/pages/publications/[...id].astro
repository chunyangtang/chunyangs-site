---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import AuthorList from '../../components/AuthorList.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import PublicationMeta from '../../components/PublicationMeta.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import { getPublications, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPublications())
    .filter((entry) => entry.data.detailPage)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'publications'>; }
const { entry } = Astro.props;
const publication = entry.data;
const featuredCoverage = publication.media.filter((item) => item.featured);
const { Content } = await render(entry);
---

<DetailLayout title={publication.title} description={publication.description} backHref="/profile#publications" backLabel="Back to publications">
  <PublicationMeta slot="eyebrow" publication={publication} fullDate />
  <div slot="metadata" class="mt-5 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
    <AuthorList authors={publication.authors} />
  </div>
  <ResourceLinks slot="actions" links={publication.links} />
  <Fragment slot="context">
    {(publication.contribution || publication.media.length > 0) && (
      <div class="mt-7 border-t border-gray-200 pt-6 dark:border-gray-800">
        {publication.contribution && (
          <section aria-labelledby="contribution-heading" class="max-w-3xl">
            <h2 id="contribution-heading" class="text-sm font-semibold text-gray-900 dark:text-gray-100">My role</h2>
            <p class="mt-2 leading-relaxed text-gray-700 dark:text-gray-300">{publication.contribution}</p>
          </section>
        )}
        {publication.media.length > 0 && (
          <p class:list={['flex flex-wrap items-center gap-x-2 gap-y-2 text-sm leading-relaxed', { 'mt-5': publication.contribution }]}>
            <span class="text-gray-500 dark:text-gray-400">Coverage:</span>
            {featuredCoverage.map((item) => (
              <span class="inline-flex items-center gap-2">
                <ExternalLink href={item.url} iconClass="" class="inline-flex items-center gap-1 text-gray-700 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-300 dark:hover:text-blue-400">{item.outlet}</ExternalLink>
                <span class="text-gray-400" aria-hidden="true">·</span>
              </span>
            ))}
            <a href="#coverage" class="whitespace-nowrap text-gray-500 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-400 dark:hover:text-blue-400">All coverage</a>
          </p>
        )}
      </div>
    )}
  </Fragment>
  {publication.image && (
    <figure slot="figure" class="mx-auto mb-10 w-full max-w-3xl sm:mb-14">
      <a href={publication.image.src} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-2xl border border-gray-200 bg-white p-3 sm:p-6 dark:border-gray-700" aria-label={`Open full-size figure for ${publication.title}`}>
        <Image src={publication.image} alt={publication.imageAlt ?? publication.title} width={1600} widths={[640, 960, 1600, 2400]} sizes="(min-width: 816px) 718px, (min-width: 640px) calc(100vw - 98px), calc(100vw - 58px)" loading="eager" class="h-auto w-full object-contain" />
      </a>
      <figcaption class="mt-3 px-1 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
        {publication.imageCaption} {publication.imageCredit}
      </figcaption>
    </figure>
  )}
  <Content />
  <Fragment slot="after-content">
    {publication.media.length > 0 && (
      <section id="coverage" aria-labelledby="coverage-heading" class="mt-12 scroll-mt-24">
        <h2 id="coverage-heading" class="mb-4 text-2xl font-bold text-gray-900 dark:text-gray-100">Media coverage</h2>
        <ul class="divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-800 dark:border-gray-800">
          {publication.media.map((item) => (
            <li>
              <ExternalLink href={item.url} iconSize={18} iconClass="text-gray-400 group-hover:text-blue-500" class="group flex items-center justify-between gap-4 py-4">
                <div class="min-w-0">
                  <p class="mb-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
                    <span>{item.outlet}</span>
                    {item.institutional && <span class="whitespace-nowrap rounded border border-gray-200 px-1.5 py-0.5 text-[10px] leading-tight dark:border-gray-700">Institutional news</span>}
                  </p>
                  <p class="font-medium leading-relaxed text-gray-800 transition-colors group-hover:text-blue-600 dark:text-gray-200 dark:group-hover:text-blue-400">{item.title}</p>
                </div>
              </ExternalLink>
            </li>
          ))}
        </ul>
      </section>
    )}
    {publication.doi && (
      <p class="mt-10 break-all text-xs leading-relaxed text-gray-500 dark:text-gray-400">
        DOI: <ExternalLink href={`https://doi.org/${publication.doi}`} iconSize={12} class="hover:text-blue-600 hover:underline dark:hover:text-blue-400">{publication.doi}</ExternalLink>
      </p>
    )}
    {publication.updatedDate && <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Updated <time datetime={publication.updatedDate.toISOString()}>{formatDate(publication.updatedDate)}</time></p>}
  </Fragment>
</DetailLayout>
